# PostgreSQL Settings
POSTGRES_USER=fleet_user
POSTGRES_PASSWORD=fleet_pass
POSTGRES_DB=fleet_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=ride_events
KAFKA_PARTITIONS=3

# Simulated Clock Settings (1 Simulated Day = 180 Real Seconds = 3 Minutes)
SIM_DAY_SECONDS=180
STREAM_INTERVAL_SECONDS=2
IDLE_ALERT_THRESHOLD_SECONDS=45